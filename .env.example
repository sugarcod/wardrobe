# Конфиг веб-приложения Firebase (Project settings → Your apps → Web app → Config).
# Скопируйте в .env.local (локально) или задайте в Netlify → Site configuration → Environment variables.
# Вместо этого можно вписать значения прямо в src/firebaseConfig.ts (MANUAL_CONFIG).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# необязательно
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# только для разработки: локальные эмуляторы (firebase emulators:start)
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
